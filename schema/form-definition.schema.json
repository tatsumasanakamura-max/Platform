{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/form-definition.schema.json",
  "title": "PoC-1 Form Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["bank_id", "product_id", "form_version", "sections", "rules", "navigation"],
  "properties": {
    "bank_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "form_version": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/navigation" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "label", "fields"],
      "properties": {
        "section_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "type", "label", "required"],
      "properties": {
        "field_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["string", "integer", "decimal", "boolean", "date", "enum"]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "autocomplete": { "type": "string" },
        "input_mode": { "enum": ["text", "email", "tel", "numeric", "decimal"] },
        "required": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "required_rule_id": { "type": "string", "minLength": 1 },
        "visibility_rule_id": { "type": "string", "minLength": 1 },
        "validation_rule_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "validators": {
          "type": "array",
          "items": { "$ref": "#/$defs/validator" }
        },
        "validation_timing": {
          "type": "array",
          "items": { "enum": ["onBlur", "onSectionNext", "onSubmit"] },
          "uniqueItems": true
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "error_code"],
      "properties": {
        "type": {
          "enum": [
            "minLength",
            "maxLength",
            "minValue",
            "maxValue",
            "email",
            "postalCodeJP",
            "phoneJP",
            "katakana",
            "date"
          ]
        },
        "value": { "type": "number" },
        "error_code": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "enum": ["minLength", "maxLength", "minValue", "maxValue"] }
            }
          },
          "then": { "properties": { "value": {} }, "required": ["value"] }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field"],
          "properties": {
            "op": {
              "enum": [
                "equals",
                "notEquals",
                "in",
                "exists",
                "greaterThanOrEqual",
                "lessThanOrEqual"
              ]
            },
            "field": { "type": "string", "minLength": 1 },
            "value": {
              "oneOf": [
                { "type": ["string", "number", "boolean", "null"] },
                {
                  "type": "array",
                  "items": { "type": ["string", "number", "boolean", "null"] }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "conditions"],
          "properties": {
            "op": { "enum": ["and", "or"] },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "condition"],
          "properties": {
            "op": { "const": "not" },
            "condition": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "type", "condition"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["visibility", "required", "validation", "navigation"] },
        "condition": { "$ref": "#/$defs/condition" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "boolean" },
            "error_code": { "type": "string" },
            "next_section_id": { "type": "string" }
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_section_id"],
      "properties": {
        "from_section_id": { "type": "string", "minLength": 1 },
        "default_next_section_id": { "type": "string", "minLength": 1 },
        "navigation_rule_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "terminal": { "type": "boolean" }
      }
    }
  }
}
