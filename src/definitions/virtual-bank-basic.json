      },
      "expected": {
        "visible_field_ids": [
          "personal.full_name",
          "personal.name_kana",
          "personal.birth_date",
          "personal.email",
          "personal.phone",
          "personal.postal_code",
          "personal.housing_type"
        ]
      }
    },
    {
      "scenario_id": "SCENARIO-OWNER",
      "name": "持ち家",
      "answers": {
        "personal.housing_type": "OWN"
      },
      "expected": {
        "visible_field_ids": [
          "personal.full_name",
          "personal.name_kana",
          "personal.birth_date",
          "personal.email",
          "personal.phone",
          "personal.postal_code",
          "personal.housing_type"
        ]
      }
    }
  ]
}
