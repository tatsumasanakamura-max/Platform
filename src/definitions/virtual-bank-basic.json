{
  "bank_id": "virtual-bank-calm",
  "product_id": "virtual-card-loan-basic",
  "form_version": "0.1.0",
  "sections": [
    {
      "section_id": "personal",
      "label": "本人情報について",
      "description": "ご本人を確認するための基本情報です。実在する個人情報は入力しないでください。",
      "fields": [
        {
          "field_id": "personal.full_name",
          "type": "string",
          "label": "氏名",
          "description": "合成データの氏名を、姓と名の間に空白を入れて入力してください。",
          "autocomplete": "off",
          "required": true,
          "validators": [
            {
              "type": "minLength",
              "value": 2,
              "error_code": "NAME_TOO_SHORT",
              "message": "氏名は2文字以上で入力してください"
            },
            {
              "type": "maxLength",
              "value": 60,
              "error_code": "NAME_TOO_LONG",
              "message": "氏名は60文字以内で入力してください"
            }
          ],
          "validation_timing": ["onBlur", "onSectionNext", "onSubmit"],
          "help_text": "合成データの氏名を、姓と名の間に空白を入れて入力してください。",
          "ui_type": "text",
          "placeholder": "例：架空 太郎",
          "example": "架空 太郎"
        },
        {
          "field_id": "personal.name_kana",
          "type": "string",
          "label": "氏名（カナ）",
          "description": "全角カタカナで入力してください。",
          "autocomplete": "off",
          "required": true,
          "validators": [
            {
              "type": "katakana",
              "error_code": "KATAKANA_INVALID",
              "message": "氏名（カナ）は全角カタカナで入力してください"
            },
            {
              "type": "maxLength",
              "value": 60,
              "error_code": "NAME_KANA_TOO_LONG",
              "message": "氏名（カナ）は60文字以内で入力してください"
            }
          ],
          "validation_timing": ["onBlur", "onSectionNext", "onSubmit"],
          "help_text": "全角カタカナで入力してください。",
          "ui_type": "text",
          "placeholder": "例：カクウ タロウ"
        },
        {
          "field_id": "personal.birth_date",
          "type": "date",
          "label": "生年月日",
          "description": "技術検証用の架空の日付を入力してください。",
          "autocomplete": "off",
          "required": true,
          "validators": [
            {
              "type": "date",
              "error_code": "DATE_INVALID",
              "message": "実在する形式の日付を入力してください"
            }
          ],
          "validation_timing": ["onSectionNext", "onSubmit"],
          "help_text": "技術検証用の架空の日付を入力してください。",
          "ui_type": "date"
        },
        {
          "field_id": "personal.email",
          "type": "string",
          "label": "メールアドレス",
          "description": "example.invalidドメインなど、実在しない合成アドレスを使用してください。",
          "autocomplete": "off",
          "input_mode": "email",
          "required": true,
          "validators": [
            {
              "type": "maxLength",
              "value": 254,
              "error_code": "EMAIL_TOO_LONG",
              "message": "メールアドレスは254文字以内で入力してください"
            },
            {
              "type": "email",
              "error_code": "EMAIL_INVALID",
              "message": "メールアドレスを正しい形式で入力してください"
            }
          ],
          "validation_timing": ["onBlur", "onSectionNext", "onSubmit"],
          "help_text": "example.invalidドメインなど、実在しない合成アドレスを使用してください。",
          "ui_type": "email",
          "placeholder": "demo@example.invalid"
        },
        {
          "field_id": "personal.phone",
          "type": "string",
          "label": "電話番号",
          "description": "ハイフンなしの10桁または11桁で、架空の番号を入力してください。",
          "autocomplete": "off",
          "input_mode": "tel",
          "required": true,
          "validators": [
            {
              "type": "phoneJP",
              "error_code": "PHONE_INVALID",
              "message": "電話番号はハイフンなしの10桁または11桁で入力してください"
            }
          ],
          "validation_timing": ["onBlur", "onSectionNext", "onSubmit"],
          "help_text": "ハイフンなしの10桁または11桁で、架空の番号を入力してください。",
          "ui_type": "tel",
          "placeholder": "0312345678"
        },
        {
          "field_id": "personal.postal_code",
          "type": "string",
          "label": "郵便番号",
          "description": "ハイフンなしの7桁で、架空の郵便番号を入力してください。",
          "autocomplete": "off",
          "input_mode": "numeric",
          "required": true,
          "validators": [
            {
              "type": "postalCodeJP",
              "error_code": "POSTAL_CODE_INVALID",
              "message": "郵便番号はハイフンなしの7桁で入力してください"
            }
          ],
          "validation_timing": ["onBlur", "onSectionNext", "onSubmit"],
          "help_text": "ハイフンなしの7桁で、架空の郵便番号を入力してください。",
          "ui_type": "text",
          "placeholder": "0000000"
        },
        {
          "field_id": "personal.housing_type",
          "type": "enum",
          "label": "お住まいの形態",
          "description": "現在の状況に近い架空の選択肢を選んでください。",
          "required": true,
          "validation_timing": ["onSectionNext", "onSubmit"],
          "options": [
            {
              "value": "OWN",
              "label": "持ち家（本人名義）"
            },
            {
              "value": "FAMILY_OWNED",
              "label": "持ち家（家族名義）"
            },
            {
              "value": "RENTAL",
              "label": "賃貸住宅"
            },
            {
              "value": "OTHER",
              "label": "その他"
            }
          ],
          "help_text": "現在の状況に近い架空の選択肢を選んでください。",
          "ui_type": "radio"
        }
      ],
      "groups": [
        {
          "group_id": "personal.contact",
          "label": "連絡先",
          "field_ids": ["personal.email", "personal.phone"]
        }
      ]
    },
    {
      "section_id": "confirmation",
      "label": "入力内容の確認",
      "fields": []
    },
    {
      "section_id": "complete",
      "label": "技術検証の完了",
      "fields": []
    }
  ],
  "rules": [],
  "navigation": [
    {
      "from_section_id": "personal",
      "default_next_section_id": "confirmation"
    },
    {
      "from_section_id": "confirmation",
      "default_next_section_id": "complete"
    },
    {
      "from_section_id": "complete",
      "terminal": true
    }
  ],
  "scenarios": [
    {
